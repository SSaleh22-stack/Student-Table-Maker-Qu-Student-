<?xml version="1.0" encoding="utf-8"?>
<!-- The الجدول widget in the widget picker: a made-up example (values*/qw_preview_strings.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/qw_preview_card"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:background="@drawable/qw_preview_mark">
      <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="center"
        android:src="@drawable/qw_calendar"
        android:tint="@color/qw_on_accent" />
    </FrameLayout>
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:text="@string/qw_ex_day"
      android:textAlignment="viewStart"
      android:textColor="@color/qw_accent"
      android:textSize="12sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/qw_preview_pill"
      android:paddingHorizontal="6dp"
      android:paddingVertical="2dp"
      android:text="@string/qw_ex_in25"
      android:textColor="@color/qw_on_accent"
      android:textSize="10sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/qw_preview_course"
    android:orientation="vertical"
    android:padding="10dp">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/qw_ex_calc"
      android:textAlignment="viewStart"
      android:textColor="@color/qw_ex_green_text"
      android:textSize="14sp"
      android:textStyle="bold"
      android:maxLines="2" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/qw_ex_calc_time"
      android:textAlignment="viewStart"
      android:textColor="@color/qw_ex_green_text"
      android:textSize="11sp"
      android:maxLines="1"
      android:ellipsize="end" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/qw_ex_calc_room"
      android:textAlignment="viewStart"
      android:textColor="@color/qw_ex_green_text"
      android:textSize="11sp"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
      android:layout_width="6dp"
      android:layout_height="6dp"
      android:background="@drawable/qw_preview_dot_orange" />
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:text="@string/qw_ex_phys"
      android:textAlignment="viewStart"
      android:textColor="@color/qw_text"
      android:textSize="11sp"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:ellipsize="end" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="@string/qw_ex_phys_time"
      android:textColor="@color/qw_muted"
      android:textSize="11sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>
