{
  "expo": {
    "name": "QU Student",
    "slug": "qu-student",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "qustudent",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF3F8",
    "ios": {
      "bundleIdentifier": "net.qustudent.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "QU Student Notebook",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "net.qustudent.qunote"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.qustudent.qunote",
            "UTTypeDescription": "QU Student Notebook",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "qunote"
              ],
              "public.mime-type": [
                "application/vnd.qustudent.qunote"
              ]
            }
          }
        ],
        "NSUbiquitousContainers": {
          "iCloud.net.qustudent.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "QU Student",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.net.qustudent.app"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.net.qustudent.app"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ]
      }
    },
    "android": {
      "package": "net.qustudent.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E7490",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/vnd.qustudent.qunote"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF3F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-localization",
        {
          "forcesRTL": true,
          "supportedLocales": [
            "ar"
          ]
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/*",
              "application/octet-stream",
              "application/zip",
              "application/vnd.qustudent.qunote"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "application/pdf"
            ]
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0E7490",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يستخدم QU Student الميكروفون لتسجيل المحاضرة أثناء كتابة ملاحظاتك في المذكرات.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم QU Student الكاميرا لمسح الأوراق وإضافة الصور إلى مذكراتك.",
          "microphonePermission": "يستخدم QU Student الميكروفون لتسجيل المحاضرة أثناء كتابة ملاحظاتك في المذكرات.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج QU Student إلى صورك لإضافتها كصفحات أو صور داخل المذكرات.",
          "cameraPermission": "يستخدم QU Student الكاميرا لمسح الأوراق وإضافة الصور إلى مذكراتك.",
          "microphonePermission": "يستخدم QU Student الميكروفون لتسجيل المحاضرة أثناء كتابة ملاحظاتك في المذكرات."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "./plugins/withNotebookNative"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "forcesRTL": true,
      "eas": {
        "projectId": "30a9ef7c-fda2-4f9a-a273-6f809c0ed6c2"
      },
      "notebook": {
        "googleWebClientId": "585597264059-2lt29h5b8opddgqrf4uhsj8oggto9i0m.apps.googleusercontent.com",
        "icloudContainer": "iCloud.net.qustudent.app"
      }
    },
    "owner": "week86874"
  }
}
